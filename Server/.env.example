# API HTTP acessível pelo Expo Go na rede local.
PORT=3001

# Gere um segredo próprio: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Credenciais do MySQL local. Copie para .env e preencha DB_PASSWORD.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ortoo_db
DB_USER=root
DB_PASSWORD=SUA_SENHA_DO_MYSQL

# Necessária apenas para criar Setup Intents reais pelo Stripe.
# STRIPE_SECRET_KEY=sk_test_...
