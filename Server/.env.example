# API HTTP acessível pelo Expo Go na rede local.
PORT=3001

# Credenciais do MySQL local. Copie para .env e preencha DB_PASSWORD.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ortoo_db
DB_USER=root
DB_PASSWORD=SUA_SENHA_DO_MYSQL

# Necessária apenas para criar Setup Intents reais pelo Stripe.
# STRIPE_SECRET_KEY=sk_test_...
